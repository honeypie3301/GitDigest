FROM node:22-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends default-jdk-headless && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY worker ./worker
COPY src/services/ingestFormatting.ts src/services/githubRateLimit.ts ./src/services/
COPY src/types ./src/types
COPY src/services/decompiler/cfr.ts ./src/services/decompiler/
COPY bin/cfr.jar bin/GitDigestCfr.java bin/CFR-LICENSE.txt ./bin/
RUN mkdir /tmp/cfr-classes \
    && javac --release 11 -cp bin/cfr.jar -d /tmp/cfr-classes bin/GitDigestCfr.java \
    && jar --create --file bin/GitDigestCfr.jar -C /tmp/cfr-classes .
RUN node node_modules/esbuild/bin/esbuild worker/server.ts --bundle --platform=node --format=esm --packages=external --outfile=worker.mjs \
    && npm prune --omit=dev --legacy-peer-deps --no-audit --no-fund

FROM node:22-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends default-jre-headless && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/worker.mjs ./worker.mjs
COPY --from=build /app/bin/cfr.jar /app/bin/GitDigestCfr.jar /app/bin/CFR-LICENSE.txt ./bin/
ENV NODE_ENV=production INGEST_DATA_DIR=/data INGEST_WORKER_PORT=3001
VOLUME /data
EXPOSE 3001
CMD ["node", "worker.mjs"]
