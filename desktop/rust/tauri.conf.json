{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitDigest",
  "mainBinaryName": "GitDigest",
  "version": "1.0.1",
  "identifier": "com.honeypie3301.gitdigest",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.github.com https://raw.githubusercontent.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../public/static/favicons/favicon.ico"],
    "windows": {
      "nsis": {
        "compression": "none",
        "installMode": "currentUser"
      }
    }
  }
}
